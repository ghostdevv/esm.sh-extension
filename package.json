{
    "name": "esm.sh-extension",
    "private": true,
    "scripts": {
        "build": "esbuild --bundle src/content.ts --outdir=extension/dist --minify --platform=browser --target=es2015",
        "format": "prettier --write .",
        "check": "prettier --check . && tsc --noEmit"
    },
    "packageManager": "pnpm@11.2.2",
    "devDependencies": {
        "@types/chrome": "^0.1.42",
        "@types/semver": "^7.7.1",
        "esbuild": "^0.28.0",
        "prettier": "^3.8.3",
        "semver": "^7.8.0"
    }
}
