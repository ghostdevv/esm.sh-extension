{
    "name": "esm.sh extension",
    "description": "Add a \"Copy esm.sh import\" button on npm package pages",
    "homepage_url": "https://github.com/ghostdevv/esm.sh-extension",
    "version": "1.0.1",
    "manifest_version": 3,
    "icons": {
        "16": "./icons/16.png",
        "19": "./icons/19.png",
        "38": "./icons/38.png",
        "48": "./icons/48.png",
        "128": "./icons/128.png"
    },
    "content_scripts": [
        {
            "run_at": "document_idle",
            "matches": ["*://npmjs.com/package/*", "*://www.npmjs.com/package/*"],
            "js": ["./dist/content.js"]
        }
    ]
}
